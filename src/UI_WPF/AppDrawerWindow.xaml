<Window x:Class="MBRDeepDrawer.AppDrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MBR-Deep Drawer"
        WindowStyle="None"
        WindowState="Normal"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="#E61C1C1C">
    <!-- Hex #E6 is 90% opacity over a dark background -->

    <Window.Resources>
        <!-- Invisible track button for clicking page up/down on the track -->
        <Style x:Key="ScrollBarTrackButton"
               TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Theme ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Width"
                    Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#1A000000"
                                CornerRadius="5">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarTrackButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#0FFFFFFF"
                                                        CornerRadius="3"
                                                        Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarTrackButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ContextMenu -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background"
                    Value="#E61C1C1C"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#4a4a4a"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="5">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"
                                            Margin="3"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme MenuItem -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Padding"
                    Value="20,8,20,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Foreground"
                                        Value="#88FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme Separator -->
        <Style TargetType="Separator"
               x:Key="{x:Static MenuItem.SeparatorStyleKey}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="#4a4a4a"
                                Margin="5,4,5,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clear Button Style for TextBoxes -->
        <Style x:Key="ClearButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#88FFFFFF"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="26"/>
            <Setter Property="Height"
                    Value="26"/>
            <Setter Property="Margin"
                    Value="0,0,5,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Advanced TextBox Style -->
        <Style x:Key="AdvancedTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="#1AFFFFFF"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,5,10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"/>
                                <Button x:Name="PART_ClearButton"
                                        Grid.Column="1"
                                        Style="{StaticResource ClearButtonStyle}"
                                        Click="ClearText_Click"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text"
                                     Value="">
                                <Setter TargetName="PART_ClearButton"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme CheckBox (Square with Checkmark) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal"
                                    Background="Transparent">
                            <Border x:Name="Border"
                                    Width="20"
                                    Height="20"
                                    Background="#1AFFFFFF"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Hidden"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme RadioButton (Square with solid inner block) -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal"
                                    Background="Transparent">
                            <Border x:Name="Border"
                                    Width="20"
                                    Height="20"
                                    Background="#1AFFFFFF"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Border x:Name="CheckMark"
                                        Width="10"
                                        Height="10"
                                        Background="White"
                                        CornerRadius="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Hidden"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"
                    Value="#1AFFFFFF"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="15,0,30,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    BorderThickness="0"/>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"
                                                CornerRadius="15">
                                            <TextBlock Text="&#xE70D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#E61C1C1C"
                                            BorderBrush="#4a4a4a"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,5,5,5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8"
                                                              ShadowDepth="2"
                                                              Opacity="0.4"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6,4,6"
                                                      SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode Switcher Tab Style -->
        <Style x:Key="TabRadioButtonStyle"
               TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="#AAAAAA"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="FontSize"
                    Value="20"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="20,8"/>
            <Setter Property="Margin"
                    Value="10,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Margin="50">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation Strip -->
        <Grid Grid.Column="0"
              Margin="0,0,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- Top flexible space -->
                <RowDefinition Height="Auto"/>
                <!-- Main Icons -->
                <RowDefinition Height="*"/>
                <!-- Bottom space (Start Button) -->
                <RowDefinition Height="Auto"/>
                <!-- Power Buttons -->
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background"
                            Value="Transparent"/>
                    <Setter Property="Foreground"
                            Value="#88FFFFFF"/>
                    <Setter Property="BorderThickness"
                            Value="0"/>
                    <Setter Property="FontSize"
                            Value="34"/>
                    <Setter Property="FontFamily"
                            Value="Segoe MDL2 Assets"/>
                    <Setter Property="Width"
                            Value="120"/>
                    <Setter Property="Height"
                            Value="120"/>
                    <Setter Property="Margin"
                            Value="0,0,0,15"/>
                    <Setter Property="Cursor"
                            Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#33FFFFFF"/>
                                        <Setter Property="Foreground"
                                                Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">

                <Button ToolTip="This PC"
                        Click="Sidebar_Computer_Click">
                    <Image Source="{Binding IconThisPC}"
                           Width="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open"
                                      Click="Sidebar_Computer_Click"/>
                            <MenuItem Header="Manage"
                                      Click="Sidebar_Computer_Manage_Click"/>
                            <Separator/>
                            <MenuItem Header="Classic"
                                      Click="Sidebar_Computer_Classic_Click"/>
                            <MenuItem Header="Properties"
                                      Click="Sidebar_Computer_Properties_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button ToolTip="Control Panel"
                        Click="Sidebar_ControlPanel_Click">
                    <Image Source="{Binding IconControlPanel}"
                           Width="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open"
                                      Click="Sidebar_ControlPanel_Click"/>
                            <Separator/>
                            <MenuItem Header="Network Center"
                                      Click="Sidebar_ControlPanel_Network_Click"/>
                            <MenuItem Header="Mouse"
                                      Click="Sidebar_ControlPanel_Mouse_Click"/>
                            <MenuItem Header="Power Options"
                                      Click="Sidebar_ControlPanel_Power_Click"/>
                            <MenuItem Header="Programs and Features"
                                      Click="Sidebar_ControlPanel_Programs_Click"/>
                            <MenuItem Header="Sound"
                                      Click="Sidebar_ControlPanel_Sound_Click"/>
                            <MenuItem Header="User Accounts"
                                      Click="Sidebar_ControlPanel_Users_Click"/>
                            <Separator/>
                            <MenuItem Header="System-Tasks"
                                      Click="Sidebar_ControlPanel_GodMode_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button ToolTip="Devices and Printers"
                        Click="Sidebar_Devices_Click">
                    <Image Source="{Binding IconDevices}"
                           Width="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <Button ToolTip="Default Apps"
                        Click="Sidebar_DefaultApps_Click">
                    <Image Source="{Binding IconDefaultApps}"
                           Width="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <Button ToolTip="Task Manager"
                        Click="Sidebar_Performance_Click">
                    <Image Source="{Binding IconPerformance}"
                           Width="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding SidebarIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </StackPanel>

            <!-- Ghosted Windows Start Button -->
            <Button Grid.Row="2"
                    ToolTip="Start Menu"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="Sidebar_Start_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- Tighter transparent border reduces the padding around the icon -->
                        <Border Background="Transparent"
                                Padding="10">
                            <Path x:Name="GhostPath"
                                  Data="M0,0 H10 V10 H0 Z M12,0 H22 V10 H12 Z M0,12 H10 V22 H0 Z M12,12 H22 V22 H12 Z"
                                  Fill="White"
                                  Opacity="0.1"
                                  Stretch="Uniform"
                                  Width="26"
                                  Height="26"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="GhostPath"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Power Controls at Bottom Left -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-10">
                <Button Content="&#xE7E8;"
                        ToolTip="Power Options"
                        Click="Sidebar_Power_Click"
                        Width="45"
                        Height="45"
                        FontSize="20"
                        Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Log Out"
                                      Click="Sidebar_Power_Logout_Click"/>
                            <MenuItem Header="Restart"
                                      Click="Sidebar_Power_Restart_Click"/>
                            <MenuItem Header="Shut Down"
                                      Click="Sidebar_Power_Shutdown_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mode Switcher Tabs & Settings Icon -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <RadioButton x:Name="TabApps"
                                 x:FieldModifier="public"
                                 Content="Apps"
                                 GroupName="ModeTabs"
                                 IsChecked="True"
                                 Style="{StaticResource TabRadioButtonStyle}"
                                 Checked="ModeTab_Changed"/>
                    <RadioButton x:Name="TabSettings"
                                 x:FieldModifier="public"
                                 Content="System-Tasks"
                                 GroupName="ModeTabs"
                                 Style="{StaticResource TabRadioButtonStyle}"
                                 Checked="ModeTab_Changed"/>
                    <RadioButton x:Name="TabPerf"
                                 x:FieldModifier="public"
                                 Content="Performance"
                                 GroupName="ModeTabs"
                                 Style="{StaticResource TabRadioButtonStyle}"
                                 Checked="ModeTab_Changed"/>
                </StackPanel>

                <!-- Settings Gear Icon -->
                <Button x:Name="BtnOpenSettings"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Foreground="#88FFFFFF"
                        BorderThickness="0"
                        Margin="0,0,20,0"
                        Cursor="Hand"
                        ToolTip="Settings"
                        Click="BtnOpenSettings_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    Padding="5">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                    <Setter Property="Background"
                                            Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- WrapPanel to display files/apps as a grid of icons -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     HorizontalContentAlignment="Left"
                     HorizontalAlignment="Stretch"
                     Margin="0,0,0,20"
                     PreviewKeyDown="ResultsList_PreviewKeyDown">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Margin"
                                Value="15,15,15,25"/>
                        <Setter Property="Padding"
                                Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#1AFFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseLeftButtonUp"
                                     Handler="ListBoxItem_MouseLeftButtonUp"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   MaxWidth="2250"
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <!-- Grouping Style for the Partition -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#88FFFFFF"
                                           FontSize="18"
                                           Margin="15,10,0,10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Left"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <!-- This panel holds the items INSIDE each group -->
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           MaxWidth="2250"
                                           IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <!-- Template for each search result tile -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="120"
                                    Height="110"
                                    Background="Transparent">

                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open"
                                              Click="MenuItem_Open_Click"/>
                                    <MenuItem Header="Run as Administrator"
                                              Click="MenuItem_RunAsAdmin_Click"/>
                                    <MenuItem Header="Open File Location"
                                              Click="MenuItem_OpenLocation_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Copy Path"
                                              Click="MenuItem_CopyPath_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>

                            <Image Source="{Binding Icon}"
                                   Width="{Binding DrawerIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Height="{Binding DrawerIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxHeight="36"
                                       ToolTip="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2"
                  Margin="0,0,0,-15"
                  HorizontalAlignment="Stretch">
                <!-- Basic Search Bar & Advanced Button -->
                <Grid x:Name="BasicSearchPanel"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <RadioButton x:Name="SortAZ"
                                     x:FieldModifier="public"
                                     Content="A-Z"
                                     GroupName="SortMode"
                                     IsChecked="True"
                                     Checked="SortMode_Changed"
                                     Margin="0,0,15,0"/>
                        <RadioButton x:Name="SortCategory"
                                     x:FieldModifier="public"
                                     Content="Categories"
                                     GroupName="SortMode"
                                     Checked="SortMode_Changed"
                                     Margin="0,0,15,0"/>
                        <RadioButton x:Name="SortFav"
                                     x:FieldModifier="public"
                                     Content="Favorites"
                                     GroupName="SortMode"
                                     Checked="SortMode_Changed"/>
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             x:FieldModifier="public"
                             Grid.Column="1"
                             Height="50"
                             Width="720"
                             FontSize="24"
                             Background="#1AFFFFFF"
                             Foreground="White"
                             CaretBrush="White"
                             BorderThickness="0"
                             Padding="15,8,15,8"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="25">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                        <Button x:Name="PART_ClearButton"
                                                Grid.Column="1"
                                                Style="{StaticResource ClearButtonStyle}"
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,8,0"
                                                Click="ClearText_Click"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Text"
                                             Value="">
                                        <Setter TargetName="PART_ClearButton"
                                                Property="Visibility"
                                                Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <Button x:Name="BtnAdvanced"
                            Grid.Column="2"
                            Width="50"
                            Height="50"
                            Margin="10,0,0,0"
                            Background="#1AFFFFFF"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Advanced Search"
                            Click="BtnAdvanced_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="25">
                                    <TextBlock Text="&#xE712;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Advanced Search Panel -->
                <Border x:Name="AdvancedPanel"
                        MaxWidth="1200"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        Padding="0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Name Contains:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <TextBox x:Name="AdvName1"
                                 Grid.Column="1"
                                 Style="{StaticResource AdvancedTextBoxStyle}"
                                 Margin="0,0,30,20"
                                 Height="45"
                                 FontSize="16"
                                 PreviewKeyDown="AdvancedField_PreviewKeyDown"/>

                        <TextBlock Grid.Column="2"
                                   Text="Content Contains:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <TextBox x:Name="AdvContent1"
                                 Grid.Column="3"
                                 Style="{StaticResource AdvancedTextBoxStyle}"
                                 Margin="0,0,0,20"
                                 Height="45"
                                 FontSize="16"
                                 PreviewKeyDown="AdvancedField_PreviewKeyDown"/>

                        <TextBlock Grid.Row="1"
                                   Text="And Name:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <TextBox x:Name="AdvName2"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource AdvancedTextBoxStyle}"
                                 Margin="0,0,30,20"
                                 Height="45"
                                 FontSize="16"
                                 PreviewKeyDown="AdvancedField_PreviewKeyDown"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="And Content:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <TextBox x:Name="AdvContent2"
                                 Grid.Row="1"
                                 Grid.Column="3"
                                 Style="{StaticResource AdvancedTextBoxStyle}"
                                 Margin="0,0,0,20"
                                 Height="45"
                                 FontSize="16"
                                 PreviewKeyDown="AdvancedField_PreviewKeyDown"/>

                        <TextBlock Grid.Row="2"
                                   Text="In Location:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <Grid Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,30,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AdvLocation"
                                     Style="{StaticResource AdvancedTextBoxStyle}"
                                     Height="45"
                                     FontSize="16"
                                     Margin="0,0,15,0"
                                     PreviewKeyDown="AdvancedField_PreviewKeyDown"/>
                            <Button x:Name="AdvBrowseBtn"
                                    Grid.Column="1"
                                    Width="100"
                                    Height="45"
                                    Content="Browse"
                                    FontSize="16"
                                    Background="#1AFFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AdvBrowseBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="22">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="2"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,20">
                            <TextBlock Text="File Type:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox x:Name="AdvFileType"
                                      Width="130"
                                      Height="45"
                                      FontSize="16"
                                      Margin="0,0,25,0"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Everything"
                                              IsSelected="True"/>
                                <ComboBoxItem Content="Document"/>
                                <ComboBoxItem Content="Folder"/>
                                <ComboBoxItem Content="Audio"/>
                                <ComboBoxItem Content="Video"/>
                                <ComboBoxItem Content="Image"/>
                                <ComboBoxItem Content="Compressed"/>
                                <ComboBoxItem Content="Executable"/>
                            </ComboBox>
                            <Button x:Name="AdvSearchActionBtn"
                                    Width="150"
                                    Height="45"
                                    Content="Search"
                                    Background="#0078D7"
                                    Foreground="White"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AdvSearchActionBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="22">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="AdvCloseBtn"
                                    Width="45"
                                    Height="45"
                                    Margin="15,0,0,0"
                                    Background="#1AFFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AdvCloseBtn_Click"
                                    ToolTip="Return to Basic Search">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="22">
                                            <TextBlock Text="&#xE72B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,0">
                            <CheckBox x:Name="AdvCaseSensitive"
                                      Content="Case Sensitive"
                                      Foreground="White"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Margin="0,0,40,0"/>

                            <TextBlock Text="Drive:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>
                            <WrapPanel x:Name="AdvDrivePanel"
                                       Orientation="Horizontal"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Performance Dashboard -->
            <Grid x:Name="PerformanceGrid"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Tile -->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="Transparent"
                        BorderBrush="#4a4a4a"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10"
                        Cursor="Hand"
                        ToolTip="Click for details"
                        MouseLeftButtonUp="CpuTile_Click">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="0">
                            <TextBlock Text="CPU"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="CpuText"
                                       Text="0%"
                                       Foreground="#0078D7"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="15,0,0,0"/>
                            <TextBlock x:Name="CpuTempText"
                                       Text="-- °C"
                                       Foreground="#aaaaaa"
                                       FontSize="18"
                                       VerticalAlignment="Bottom"
                                       Margin="15,0,0,4"/>
                        </StackPanel>
                        <!-- The Canvas where we will draw our native graph -->
                        <Canvas x:Name="CpuCanvas"
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                ClipToBounds="True"
                                SizeChanged="Canvas_SizeChanged">
                            <Polygon x:Name="CpuShade"
                                     Fill="#330078D7"/>
                            <Polyline x:Name="CpuLine"
                                      Stroke="#CC0078D7"
                                      StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- RAM Tile -->
                <Border Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Background="Transparent"
                        BorderBrush="#4a4a4a"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10"
                        Cursor="Hand"
                        ToolTip="Click for details"
                        MouseLeftButtonUp="RamTile_Click">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="0">
                            <TextBlock Text="Memory"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="RamText"
                                       Text="0%"
                                       Foreground="#55FF55"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="15,0,0,0"/>
                            <TextBlock x:Name="RamDetailText"
                                       Text="0.0 / 0.0 GB"
                                       Foreground="#aaaaaa"
                                       FontSize="18"
                                       VerticalAlignment="Bottom"
                                       Margin="15,0,0,4"/>
                        </StackPanel>
                        <!-- The Canvas where we will draw our native graph -->
                        <Canvas x:Name="RamCanvas"
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                ClipToBounds="True"
                                SizeChanged="Canvas_SizeChanged">
                            <Polygon x:Name="RamShade"
                                     Fill="#3355FF55"/>
                            <Polyline x:Name="RamLine"
                                      Stroke="#CC55FF55"
                                      StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- GPU Tile -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Background="Transparent"
                        BorderBrush="#4a4a4a"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10"
                        Cursor="Hand"
                        ToolTip="Click for details"
                        MouseLeftButtonUp="GpuTile_Click">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="0">
                            <TextBlock Text="GPU"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuText"
                                       Text="0%"
                                       Foreground="#A200FF"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="15,0,0,0"/>
                            <TextBlock x:Name="GpuDetailText"
                                       Text="0.0 GB"
                                       Foreground="#aaaaaa"
                                       FontSize="18"
                                       VerticalAlignment="Bottom"
                                       Margin="15,0,0,4"/>
                            <TextBlock x:Name="GpuTempText"
                                       Text="-- °C"
                                       Foreground="#aaaaaa"
                                       FontSize="18"
                                       VerticalAlignment="Bottom"
                                       Margin="15,0,0,4"/>
                        </StackPanel>
                        <Canvas x:Name="GpuCanvas"
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                ClipToBounds="True"
                                SizeChanged="Canvas_SizeChanged">
                            <Polygon x:Name="GpuShade"
                                     Fill="#33A200FF"/>
                            <Polyline x:Name="GpuLine"
                                      Stroke="#CCA200FF"
                                      StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Disk Tile -->
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderBrush="#4a4a4a"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10"
                        Cursor="Hand"
                        ToolTip="Click for details"
                        MouseLeftButtonUp="DiskTile_Click">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="0">
                            <TextBlock Text="Disk"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="DiskText"
                                       Text="0%"
                                       Foreground="#D70078"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="15,0,0,0"/>
                            <TextBlock x:Name="DiskDetailText"
                                       Text="R: 0 / W: 0 KB/s"
                                       Foreground="#aaaaaa"
                                       FontSize="18"
                                       VerticalAlignment="Bottom"
                                       Margin="15,0,0,4"/>
                        </StackPanel>
                        <Canvas x:Name="DiskCanvas"
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                ClipToBounds="True"
                                SizeChanged="Canvas_SizeChanged">
                            <Polygon x:Name="DiskShade"
                                     Fill="#33D70078"/>
                            <Polyline x:Name="DiskLine"
                                      Stroke="#CCD70078"
                                      StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Network Tile -->
                <Border Grid.Row="1"
                        Grid.Column="2"
                        Background="Transparent"
                        BorderBrush="#4a4a4a"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10"
                        Cursor="Hand"
                        ToolTip="Click for details"
                        MouseLeftButtonUp="NetTile_Click">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="0">
                            <TextBlock Text="Network"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="NetText"
                                       Text="0 B/s"
                                       Foreground="#D77800"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="15,0,0,0"/>
                            <TextBlock x:Name="NetDetailText"
                                       Text="R: 0 / S: 0 B/s"
                                       Foreground="#aaaaaa"
                                       FontSize="18"
                                       VerticalAlignment="Bottom"
                                       Margin="15,0,0,4"/>
                        </StackPanel>
                        <Canvas x:Name="NetCanvas"
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                ClipToBounds="True"
                                SizeChanged="Canvas_SizeChanged">
                            <Polygon x:Name="NetShade"
                                     Fill="#33D77800"/>
                            <Polyline x:Name="NetLine"
                                      Stroke="#CCD77800"
                                      StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>

            <!-- Detailed CPU Dashboard -->
            <Grid x:Name="DetailedCpuGrid"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="10,0,0,10">
                    <Button x:Name="DetailedCpuBackBtn"
                            ToolTip="Back to Overview"
                            Click="DetailedBackBtn_Click"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,15,0">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Logical Processors"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="DetailedCpuTempText"
                               Text="-- °C"
                               Foreground="#aaaaaa"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </StackPanel>
                <UniformGrid x:Name="CpuCoresPanel"
                             Grid.Row="1"
                             Margin="0,10,0,0"/>
            </Grid>

            <!-- Detailed RAM Dashboard -->
            <Grid x:Name="DetailedRamGrid"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="10,0,0,10">
                    <Button ToolTip="Back to Overview"
                            Click="DetailedBackBtn_Click"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,15,0">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Memory"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="1"
                        Background="Transparent"
                        BorderBrush="#4a4a4a"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10">
                    <Grid Margin="20">
                        <Canvas x:Name="DetailedRamCanvas"
                                ClipToBounds="True"
                                SizeChanged="Canvas_SizeChanged">
                            <Polygon x:Name="DetailedRamShade"
                                     Fill="#3355FF55"/>
                            <Polyline x:Name="DetailedRamLine"
                                      Stroke="#CC55FF55"
                                      StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock Text="In Use: "
                               Foreground="#aaaaaa"
                               FontSize="18"/>
                    <TextBlock x:Name="DetailedRamUsed"
                               Text="0.0 GB"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="Available: "
                               Foreground="#aaaaaa"
                               FontSize="18"/>
                    <TextBlock x:Name="DetailedRamAvail"
                               Text="0.0 GB"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="Total: "
                               Foreground="#aaaaaa"
                               FontSize="18"/>
                    <TextBlock x:Name="DetailedRamTotal"
                               Text="0.0 GB"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Detailed GPU Dashboard -->
            <Grid x:Name="DetailedGpuGrid"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="10,0,0,10">
                    <Button ToolTip="Back to Overview"
                            Click="DetailedBackBtn_Click"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,15,0">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="GPU"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="1"
                        Background="Transparent"
                        BorderBrush="#4a4a4a"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10">
                    <Grid Margin="20">
                        <Canvas x:Name="DetailedGpuCanvas"
                                ClipToBounds="True"
                                SizeChanged="Canvas_SizeChanged">
                            <Polygon x:Name="DetailedGpuShade"
                                     Fill="#33A200FF"/>
                            <Polyline x:Name="DetailedGpuLine"
                                      Stroke="#CCA200FF"
                                      StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock Text="Utilization: "
                               Foreground="#aaaaaa"
                               FontSize="18"/>
                    <TextBlock x:Name="DetailedGpuUtil"
                               Text="0%"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="Dedicated Memory: "
                               Foreground="#aaaaaa"
                               FontSize="18"/>
                    <TextBlock x:Name="DetailedGpuMem"
                               Text="0.0 GB"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Temp: "
                               Foreground="#aaaaaa"
                               FontSize="18"
                               Margin="30,0,0,0"/>
                    <TextBlock x:Name="DetailedGpuTempText"
                               Text="-- °C"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Detailed Disk Dashboard -->
            <Grid x:Name="DetailedDiskGrid"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="10,0,0,10">
                    <Button ToolTip="Back to Overview"
                            Click="DetailedBackBtn_Click"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,15,0">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Disk"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <UniformGrid x:Name="DetailedDiskPanel"
                             Grid.Row="1"
                             Margin="0,10,0,0"/>
            </Grid>

            <!-- Detailed Network Dashboard -->
            <Grid x:Name="DetailedNetGrid"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="10,0,0,10">
                    <Button ToolTip="Back to Overview"
                            Click="DetailedBackBtn_Click"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,15,0">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Network"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="1"
                        Background="Transparent"
                        BorderBrush="#4a4a4a"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10">
                    <Grid Margin="20">
                        <Canvas x:Name="DetailedNetCanvas"
                                ClipToBounds="True"
                                SizeChanged="Canvas_SizeChanged">
                            <Polygon x:Name="DetailedNetShade"
                                     Fill="#33D77800"/>
                            <Polyline x:Name="DetailedNetLine"
                                      Stroke="#CCD77800"
                                      StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock Text="Send: "
                               Foreground="#aaaaaa"
                               FontSize="18"/>
                    <TextBlock x:Name="DetailedNetSend"
                               Text="0 B/s"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="Receive: "
                               Foreground="#aaaaaa"
                               FontSize="18"/>
                    <TextBlock x:Name="DetailedNetRecv"
                               Text="0 B/s"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Settings Dashboard -->
            <Grid x:Name="SettingsDashboardGrid"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="10,0,0,20">
                    <TextBlock Text="Settings"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="800"
                                HorizontalAlignment="Left"
                                Margin="10,0,0,0">
                        <!-- Appearance Section -->
                        <TextBlock Text="Appearance"
                                   Foreground="#0078D7"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Color Palette:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="SettingsColorPalette"
                                      Grid.Column="1"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="SettingsColorPalette_SelectionChanged">
                                <ComboBoxItem Content="MBR-Deep Dark"
                                              IsSelected="True"/>
                                <ComboBoxItem Content="OLED Pitch Black"/>
                                <ComboBoxItem Content="Crimson Red"/>
                                <ComboBoxItem Content="Neon Green"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Background Opacity:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="SettingsOpacitySlider"
                                    Grid.Column="1"
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    Minimum="0.5"
                                    Maximum="1.0"
                                    Value="0.9"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsOpacitySlider_ValueChanged"/>
                        </Grid>

                        <!-- Animations Section -->
                        <TextBlock Text="Animations"
                                   Foreground="#0078D7"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transition Effect:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="SettingsEffect"
                                      Grid.Column="1"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="SettingsEffect_SelectionChanged">
                                <ComboBoxItem Content="Genie"/>
                                <ComboBoxItem Content="None"
                                              IsSelected="True"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Animation Speed:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="SettingsSpeedSlider"
                                    Grid.Column="1"
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    Minimum="0.1"
                                    Maximum="2.0"
                                    Value="0.5"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsSpeedSlider_ValueChanged"/>
                        </Grid>

                        <!-- Layout & Scaling Section -->
                        <TextBlock Text="Layout &amp; Scaling"
                                   Foreground="#0078D7"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Drawer Icon Size:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="SettingsDrawerIconSize"
                                    Grid.Column="1"
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    Minimum="48"
                                    Maximum="128"
                                    Value="64"
                                    TickFrequency="4"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsDrawerIconSize_ValueChanged"/>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sidebar Icon Size:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="SettingsSidebarIconSize"
                                    Grid.Column="1"
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    Minimum="48"
                                    Maximum="96"
                                    Value="72"
                                    TickFrequency="4"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsSidebarIconSize_ValueChanged"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
