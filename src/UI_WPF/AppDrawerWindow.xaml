<Window x:Class="AppDrawerXAML.AppDrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MBR-Deep Drawer"
        WindowStyle="None"
        WindowState="Normal"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="#E61C1C1C">
    <!-- Hex #E6 is 90% opacity over a dark background -->

    <Window.Resources>
        <!-- Invisible track button for clicking page up/down on the track -->
        <Style x:Key="ScrollBarTrackButton"
               TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Theme ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Width"
                    Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#1A000000"
                                CornerRadius="5">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarTrackButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#0FFFFFFF"
                                                        CornerRadius="3"
                                                        Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarTrackButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ContextMenu -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background"
                    Value="#2b2b2b"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#4a4a4a"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="5">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"
                                            Margin="3"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme MenuItem -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Padding"
                    Value="20,8,20,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Foreground"
                                        Value="#88FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme Separator -->
        <Style TargetType="Separator"
               x:Key="{x:Static MenuItem.SeparatorStyleKey}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="#4a4a4a"
                                Margin="5,4,5,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clear Button Style for TextBoxes -->
        <Style x:Key="ClearButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#88FFFFFF"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="26"/>
            <Setter Property="Height"
                    Value="26"/>
            <Setter Property="Margin"
                    Value="0,0,5,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Advanced TextBox Style -->
        <Style x:Key="AdvancedTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="#1AFFFFFF"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,5,10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"/>
                                <Button x:Name="PART_ClearButton"
                                        Grid.Column="1"
                                        Style="{StaticResource ClearButtonStyle}"
                                        Click="ClearText_Click"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text"
                                     Value="">
                                <Setter TargetName="PART_ClearButton"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme CheckBox (Square with Checkmark) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal"
                                    Background="Transparent">
                            <Border x:Name="Border"
                                    Width="20"
                                    Height="20"
                                    Background="#1AFFFFFF"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Hidden"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme RadioButton (Square with solid inner block) -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal"
                                    Background="Transparent">
                            <Border x:Name="Border"
                                    Width="20"
                                    Height="20"
                                    Background="#1AFFFFFF"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Border x:Name="CheckMark"
                                        Width="10"
                                        Height="10"
                                        Background="White"
                                        CornerRadius="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Hidden"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"
                    Value="#1AFFFFFF"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="15,0,30,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    BorderThickness="0"/>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"
                                                CornerRadius="15">
                                            <TextBlock Text="&#xE70D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2b2b2b"
                                            BorderBrush="#4a4a4a"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,5,5,5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8"
                                                              ShadowDepth="2"
                                                              Opacity="0.4"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6,4,6"
                                                      SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode Switcher Tab Style -->
        <Style x:Key="TabRadioButtonStyle"
               TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="#AAAAAA"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="FontSize"
                    Value="20"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="20,8"/>
            <Setter Property="Margin"
                    Value="10,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="50">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation Strip -->
        <Grid Grid.Column="0"
              Margin="0,0,40,0">
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background"
                            Value="Transparent"/>
                    <Setter Property="Foreground"
                            Value="#88FFFFFF"/>
                    <Setter Property="BorderThickness"
                            Value="0"/>
                    <Setter Property="FontSize"
                            Value="34"/>
                    <Setter Property="FontFamily"
                            Value="Segoe MDL2 Assets"/>
                    <Setter Property="Width"
                            Value="120"/>
                    <Setter Property="Height"
                            Value="120"/>
                    <Setter Property="Margin"
                            Value="0,0,0,15"/>
                    <Setter Property="Cursor"
                            Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#33FFFFFF"/>
                                        <Setter Property="Foreground"
                                                Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <StackPanel VerticalAlignment="Center"
                        DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">

                <Button ToolTip="This PC"
                        Click="Sidebar_Computer_Click">
                    <Image Source="{Binding IconThisPC}"
                           Width="72"
                           Height="72"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open"
                                      Click="Sidebar_Computer_Click"/>
                            <MenuItem Header="Manage"
                                      Click="Sidebar_Computer_Manage_Click"/>
                            <Separator/>
                            <MenuItem Header="Classic"
                                      Click="Sidebar_Computer_Classic_Click"/>
                            <MenuItem Header="Properties"
                                      Click="Sidebar_Computer_Properties_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button ToolTip="Control Panel"
                        Click="Sidebar_ControlPanel_Click">
                    <Image Source="{Binding IconControlPanel}"
                           Width="72"
                           Height="72"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open"
                                      Click="Sidebar_ControlPanel_Click"/>
                            <Separator/>
                            <MenuItem Header="Network Center"
                                      Click="Sidebar_ControlPanel_Network_Click"/>
                            <MenuItem Header="Mouse"
                                      Click="Sidebar_ControlPanel_Mouse_Click"/>
                            <MenuItem Header="Power Options"
                                      Click="Sidebar_ControlPanel_Power_Click"/>
                            <MenuItem Header="Programs and Features"
                                      Click="Sidebar_ControlPanel_Programs_Click"/>
                            <MenuItem Header="Sound"
                                      Click="Sidebar_ControlPanel_Sound_Click"/>
                            <MenuItem Header="User Accounts"
                                      Click="Sidebar_ControlPanel_Users_Click"/>
                            <Separator/>
                            <MenuItem Header="System-Tasks"
                                      Click="Sidebar_ControlPanel_GodMode_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button ToolTip="Devices and Printers"
                        Click="Sidebar_Devices_Click">
                    <Image Source="{Binding IconDevices}"
                           Width="72"
                           Height="72"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <Button ToolTip="Default Apps"
                        Click="Sidebar_DefaultApps_Click">
                    <Image Source="{Binding IconDefaultApps}"
                           Width="72"
                           Height="72"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <Button ToolTip="Performance"
                        Click="Sidebar_Performance_Click">
                    <Image Source="{Binding IconPerformance}"
                           Width="72"
                           Height="72"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </StackPanel>

            <!-- Power Controls at Bottom Left -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-10">
                <Button Content="&#xF3B1;"
                        ToolTip="Log Out"
                        Click="Sidebar_Power_Logout_Click"
                        Width="45"
                        Height="45"
                        FontSize="20"
                        Margin="0,0,10,0"/>
                <Button Content="&#xE777;"
                        ToolTip="Restart"
                        Click="Sidebar_Power_Restart_Click"
                        Width="45"
                        Height="45"
                        FontSize="20"
                        Margin="0,0,10,0"/>
                <Button Content="&#xE7E8;"
                        ToolTip="Shut Down"
                        Click="Sidebar_Power_Shutdown_Click"
                        Width="45"
                        Height="45"
                        FontSize="20"
                        Margin="0"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mode Switcher Tabs -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15">
                <RadioButton x:Name="TabApps"
                             x:FieldModifier="public"
                             Content="Apps"
                             GroupName="ModeTabs"
                             IsChecked="True"
                             Style="{StaticResource TabRadioButtonStyle}"
                             Checked="ModeTab_Changed"/>
                <RadioButton x:Name="TabSettings"
                             x:FieldModifier="public"
                             Content="System-Tasks"
                             GroupName="ModeTabs"
                             Style="{StaticResource TabRadioButtonStyle}"
                             Checked="ModeTab_Changed"/>
            </StackPanel>

            <!-- WrapPanel to display files/apps as a grid of icons -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     HorizontalContentAlignment="Left"
                     HorizontalAlignment="Stretch"
                     Margin="0,0,0,20"
                     PreviewKeyDown="ResultsList_PreviewKeyDown">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Margin"
                                Value="15,15,15,25"/>
                        <Setter Property="Padding"
                                Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#1AFFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseLeftButtonUp"
                                     Handler="ListBoxItem_MouseLeftButtonUp"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   MaxWidth="2250"
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <!-- Grouping Style for the Partition -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#88FFFFFF"
                                           FontSize="18"
                                           Margin="15,10,0,10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Left"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <!-- This panel holds the items INSIDE each group -->
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           MaxWidth="2250"
                                           IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <!-- Template for each search result tile -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="120"
                                    Height="110"
                                    Background="Transparent">

                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open"
                                              Click="MenuItem_Open_Click"/>
                                    <MenuItem Header="Run as Administrator"
                                              Click="MenuItem_RunAsAdmin_Click"/>
                                    <MenuItem Header="Open File Location"
                                              Click="MenuItem_OpenLocation_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Copy Path"
                                              Click="MenuItem_CopyPath_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>

                            <Image Source="{Binding Icon}"
                                   Width="64"
                                   Height="64"
                                   Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxHeight="36"
                                       ToolTip="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2"
                  Margin="0,0,0,-15"
                  HorizontalAlignment="Stretch">
                <!-- Basic Search Bar & Advanced Button -->
                <Grid x:Name="BasicSearchPanel"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <RadioButton x:Name="SortAZ"
                                     x:FieldModifier="public"
                                     Content="A-Z"
                                     GroupName="SortMode"
                                     IsChecked="True"
                                     Checked="SortMode_Changed"
                                     Margin="0,0,15,0"/>
                        <RadioButton x:Name="SortCategory"
                                     x:FieldModifier="public"
                                     Content="Categories"
                                     GroupName="SortMode"
                                     Checked="SortMode_Changed"
                                     Margin="0,0,15,0"/>
                        <RadioButton x:Name="SortFav"
                                     x:FieldModifier="public"
                                     Content="Favorites"
                                     GroupName="SortMode"
                                     Checked="SortMode_Changed"/>
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             x:FieldModifier="public"
                             Grid.Column="1"
                             Height="50"
                             Width="720"
                             FontSize="24"
                             Background="#1AFFFFFF"
                             Foreground="White"
                             CaretBrush="White"
                             BorderThickness="0"
                             Padding="15,8,15,8"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="25">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                        <Button x:Name="PART_ClearButton"
                                                Grid.Column="1"
                                                Style="{StaticResource ClearButtonStyle}"
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,8,0"
                                                Click="ClearText_Click"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Text"
                                             Value="">
                                        <Setter TargetName="PART_ClearButton"
                                                Property="Visibility"
                                                Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <Button x:Name="BtnAdvanced"
                            Grid.Column="2"
                            Width="50"
                            Height="50"
                            Margin="10,0,0,0"
                            Background="#1AFFFFFF"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Advanced Search"
                            Click="BtnAdvanced_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="25">
                                    <TextBlock Text="&#xE712;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Advanced Search Panel -->
                <Border x:Name="AdvancedPanel"
                        MaxWidth="1200"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        Padding="0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Name Contains:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <TextBox x:Name="AdvName1"
                                 Grid.Column="1"
                                 Style="{StaticResource AdvancedTextBoxStyle}"
                                 Margin="0,0,30,20"
                                 Height="45"
                                 FontSize="16"
                                 PreviewKeyDown="AdvancedField_PreviewKeyDown"/>

                        <TextBlock Grid.Column="2"
                                   Text="Content Contains:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <TextBox x:Name="AdvContent1"
                                 Grid.Column="3"
                                 Style="{StaticResource AdvancedTextBoxStyle}"
                                 Margin="0,0,0,20"
                                 Height="45"
                                 FontSize="16"
                                 PreviewKeyDown="AdvancedField_PreviewKeyDown"/>

                        <TextBlock Grid.Row="1"
                                   Text="And Name:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <TextBox x:Name="AdvName2"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource AdvancedTextBoxStyle}"
                                 Margin="0,0,30,20"
                                 Height="45"
                                 FontSize="16"
                                 PreviewKeyDown="AdvancedField_PreviewKeyDown"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="And Content:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <TextBox x:Name="AdvContent2"
                                 Grid.Row="1"
                                 Grid.Column="3"
                                 Style="{StaticResource AdvancedTextBoxStyle}"
                                 Margin="0,0,0,20"
                                 Height="45"
                                 FontSize="16"
                                 PreviewKeyDown="AdvancedField_PreviewKeyDown"/>

                        <TextBlock Grid.Row="2"
                                   Text="In Location:"
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,20"/>
                        <Grid Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,30,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AdvLocation"
                                     Style="{StaticResource AdvancedTextBoxStyle}"
                                     Height="45"
                                     FontSize="16"
                                     Margin="0,0,15,0"
                                     PreviewKeyDown="AdvancedField_PreviewKeyDown"/>
                            <Button x:Name="AdvBrowseBtn"
                                    Grid.Column="1"
                                    Width="100"
                                    Height="45"
                                    Content="Browse"
                                    FontSize="16"
                                    Background="#1AFFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AdvBrowseBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="22">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="2"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,20">
                            <TextBlock Text="File Type:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox x:Name="AdvFileType"
                                      Width="130"
                                      Height="45"
                                      FontSize="16"
                                      Margin="0,0,25,0"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Everything"
                                              IsSelected="True"/>
                                <ComboBoxItem Content="Document"/>
                                <ComboBoxItem Content="Folder"/>
                                <ComboBoxItem Content="Audio"/>
                                <ComboBoxItem Content="Video"/>
                                <ComboBoxItem Content="Image"/>
                                <ComboBoxItem Content="Compressed"/>
                                <ComboBoxItem Content="Executable"/>
                            </ComboBox>
                            <Button x:Name="AdvSearchActionBtn"
                                    Width="150"
                                    Height="45"
                                    Content="Search"
                                    Background="#0078D7"
                                    Foreground="White"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AdvSearchActionBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="22">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="AdvCloseBtn"
                                    Width="45"
                                    Height="45"
                                    Margin="15,0,0,0"
                                    Background="#1AFFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AdvCloseBtn_Click"
                                    ToolTip="Return to Basic Search">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="22">
                                            <TextBlock Text="&#xE72B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,0">
                            <CheckBox x:Name="AdvCaseSensitive"
                                      Content="Case Sensitive"
                                      Foreground="White"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Margin="0,0,40,0"/>

                            <TextBlock Text="Drive:"
                                       Foreground="#AAAAAA"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>
                            <WrapPanel x:Name="AdvDrivePanel"
                                       Orientation="Horizontal"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
