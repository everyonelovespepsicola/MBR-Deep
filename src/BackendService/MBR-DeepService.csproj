<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>MBR-Deep Engine</AssemblyTitle>
    <Product>MBR-Deep</Product>
    <Description>MBR-Deep Background Search Engine Service</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="PdfPig" Version="0.1.8" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ensure C-Engine DLL is copied directly to the backend output folder -->
    <None Include="..\Engine\fast_search.dll">
      <Link>fast_search.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
